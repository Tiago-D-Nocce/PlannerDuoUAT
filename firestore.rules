rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() { return request.auth != null; }
    function meuEmail()    { return request.auth.token.email; }

    // Documentos do casal (finanças, viagens, metas, checklist)
    match /casais/{casalId} {
      // Dono: o ID do documento é o próprio UID do usuário
      function souDono() {
        return autenticado() && casalId == request.auth.uid;
      }
      // Membro: e-mail do usuário consta no mapa 'membros' do documento
      function souMembro() {
        return autenticado()
          && resource.data.membros != null
          && meuEmail() in resource.data.membros;
      }

      allow create: if souDono();
      allow read, write: if souDono() || souMembro();

      // Ingresso via convite: um usuário que ainda não é membro pode se
      // adicionar a um espaço com menos de 2 membros. Restrições:
      //   - só o campo 'membros' pode mudar (nada de ler/alterar dados);
      //   - o conjunto novo é exatamente o antigo + o próprio e-mail;
      //   - o e-mail adicionado é o do requisitante, não um terceiro.
      // Sem isso, qualquer autenticado podia sobrescrever 'membros' inteiro.
      allow update: if autenticado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
        && resource.data.membros != null
        && resource.data.membros.size() < 2
        && !(meuEmail() in resource.data.membros)
        && request.resource.data.membros.keys().hasAll(resource.data.membros.keys())
        && request.resource.data.membros.size() == resource.data.membros.size() + 1
        && meuEmail() in request.resource.data.membros;
    }

    // Convites de parceiro. O código é o ID do documento, então 'get' precisa
    // ficar aberto a qualquer autenticado (quem aceita não é quem criou).
    // 'list' segue bloqueado — não há como enumerar convites.
    // 'delete' é restrito ao criador: antes qualquer autenticado podia
    // apagar convites alheios.
    match /convites/{codigo} {
      allow get:    if autenticado();
      allow create: if autenticado() && request.resource.data.criadoPor == meuEmail();
      allow delete: if autenticado() && resource.data.criadoPor == meuEmail();
    }

    // Bloqueia todo o resto
    match /{document=**} { allow read, write: if false; }
  }
}
